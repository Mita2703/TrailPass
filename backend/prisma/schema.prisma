generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  climber
  organizer
  admin
  officer
}

enum OrganizerStatus {
  pending
  approved
  blocked
}

enum IdType {
  ktp
  sim
  kia
  passport
}

enum Gender {
  male
  female
}

enum VerifiedStatus {
  pending
  verified
  rejected
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(255)
  passwordHash     String?          @map("password_hash") @db.VarChar(255)
  googleId         String?          @unique @map("google_id") @db.VarChar(100)
  role             Role
  fullName         String           @map("full_name") @db.VarChar(150)
  phone            String?          @db.VarChar(20)
  emailVerifiedAt  DateTime?        @map("email_verified_at")
  organizationName String?          @map("organization_name") @db.VarChar(150)
  organizerStatus  OrganizerStatus? @map("organizer_status")
  createdById      String?          @map("created_by") @db.Uuid
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  createdBy        User?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers     User[]           @relation("UserCreatedBy")
  profile          ClimberProfile?  @relation("ProfileOwner")
  verifiedProfiles ClimberProfile[] @relation("ProfileVerifier")

  organizerOf        MountainOrganizer[] @relation("OrganizerUser")
  organizerAssigned  MountainOrganizer[] @relation("OrganizerAssigner")
  officerAssignments OfficerAssignment[]
  advisoriesSet      TrailAdvisory[]

  @@map("users")
}

model ClimberProfile {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @unique @map("user_id") @db.Uuid
  nik                   String         @db.VarChar(16)
  idType                IdType         @map("id_type")
  birthDate             DateTime       @map("birth_date") @db.Date
  gender                Gender
  emergencyContactName  String         @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String         @map("emergency_contact_phone") @db.VarChar(20)
  idPhotoUrl            String         @map("id_photo_url") @db.VarChar(500)
  privacyConsentAt      DateTime       @map("privacy_consent_at")
  verifiedStatus        VerifiedStatus @default(pending) @map("verified_status")
  rejectionReason       String?        @map("rejection_reason")
  verifiedById          String?        @map("verified_by") @db.Uuid
  verifiedAt            DateTime?      @map("verified_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user       User  @relation("ProfileOwner", fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("ProfileVerifier", fields: [verifiedById], references: [id])

  @@index([nik])
  @@map("climber_profiles")
}

enum Difficulty {
  easy
  medium
  hard
}

model Mountain {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(150)
  slug           String   @unique @db.VarChar(160)
  province       String   @db.VarChar(100)
  regency        String   @db.VarChar(100)
  elevationM     Int      @map("elevation_m")
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  timezone       String   @default("Asia/Jakarta") @db.VarChar(40)
  description    String?
  coverImage     String?  @map("cover_image") @db.VarChar(500)
  managingAgency String?  @map("managing_agency") @db.VarChar(200)
  officialUrl    String?  @map("official_url") @db.VarChar(500)
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rules  MountainRule?
  trails Trail[]

  organizers  MountainOrganizer[]
  officers    OfficerAssignment[]
  attractions Attraction[]
  documents   Document[]
  contents    MountainContent[]

  @@map("mountains")
}

model MountainRule {
  id                     String  @id @default(uuid()) @db.Uuid
  mountainId             String  @unique @map("mountain_id") @db.Uuid
  minGroup               Int     @default(1) @map("min_group")
  maxGroup               Int     @map("max_group")
  minAge                 Int?    @map("min_age")
  bookingCutoffDays      Int     @default(0) @map("booking_cutoff_days")
  holdMinutes            Int     @map("hold_minutes")
  maxDurationDays        Int     @map("max_duration_days")
  rescheduleDeadlineDays Int?    @map("reschedule_deadline_days")
  requireBriefing        Boolean @default(false) @map("require_briefing")
  extraRules             Json?   @map("extra_rules")

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Restrict)

  @@map("mountain_rules")
}

model Trail {
  id             String      @id @default(uuid()) @db.Uuid
  mountainId     String      @map("mountain_id") @db.Uuid
  name           String      @db.VarChar(150)
  distanceKm     Decimal?    @map("distance_km") @db.Decimal(5, 2)
  estimatedHours Decimal?    @map("estimated_hours") @db.Decimal(4, 1)
  difficulty     Difficulty?
  price          Int
  priceForeign   Int?        @map("price_foreign")
  extraFees      Json?       @map("extra_fees")
  queueEnabled   Boolean     @default(true) @map("queue_enabled")
  queueMaxActive Int         @default(30) @map("queue_max_active")
  ruleOverrides  Json?       @map("rule_overrides")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  mountain    Mountain     @relation(fields: [mountainId], references: [id], onDelete: Restrict)
  checkpoints Checkpoint[]

  advisories TrailAdvisory[]

  @@index([mountainId])
  @@map("trails")
}

model Checkpoint {
  id       String   @id @default(uuid()) @db.Uuid
  trailId  String   @map("trail_id") @db.Uuid
  name     String   @db.VarChar(150)
  orderNo  Int      @map("order_no")
  lat      Decimal? @db.Decimal(9, 6)
  lng      Decimal? @db.Decimal(9, 6)
  isSummit Boolean  @default(false) @map("is_summit")

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)

  advisories TrailAdvisory[]

  @@unique([trailId, orderNo])
  @@map("checkpoints")
}

enum AdvisoryStatus {
  open
  limited
  closed
}

enum Severity {
  info
  warning
  danger
}

enum ContentType {
  tutorial
  faq
  checklist
  news
}

model MountainOrganizer {
  mountainId   String   @map("mountain_id") @db.Uuid
  organizerId  String   @map("organizer_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  mountain   Mountain @relation(fields: [mountainId], references: [id], onDelete: Restrict)
  organizer  User     @relation("OrganizerUser", fields: [organizerId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("OrganizerAssigner", fields: [assignedById], references: [id])

  @@id([mountainId, organizerId])
  @@map("mountain_organizers")
}

model OfficerAssignment {
  officerId  String @map("officer_id") @db.Uuid
  mountainId String @map("mountain_id") @db.Uuid

  officer  User     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Restrict)

  @@id([officerId, mountainId])
  @@map("officer_assignments")
}

model TrailAdvisory {
  id              String         @id @default(uuid()) @db.Uuid
  trailId         String         @map("trail_id") @db.Uuid
  status          AdvisoryStatus
  maxCheckpointId String?        @map("max_checkpoint_id") @db.Uuid
  reason          String?        @db.VarChar(200)
  message         String?
  severity        Severity       @default(info)
  validFrom       DateTime       @map("valid_from")
  validUntil      DateTime?      @map("valid_until")
  sourceUrl       String?        @map("source_url") @db.VarChar(500)
  setById         String         @map("set_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  trail         Trail       @relation(fields: [trailId], references: [id], onDelete: Restrict)
  maxCheckpoint Checkpoint? @relation(fields: [maxCheckpointId], references: [id])
  setBy         User        @relation(fields: [setById], references: [id])

  @@index([trailId, validFrom])
  @@map("trail_advisories")
}

model Attraction {
  id          String   @id @default(uuid()) @db.Uuid
  mountainId  String   @map("mountain_id") @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  image       String?  @db.VarChar(500)
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@map("attractions")
}

model Document {
  id         String @id @default(uuid()) @db.Uuid
  mountainId String @map("mountain_id") @db.Uuid
  title      String @db.VarChar(200)
  category   String @db.VarChar(100)
  fileUrl    String @map("file_url") @db.VarChar(500)

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model MountainContent {
  id         String      @id @default(uuid()) @db.Uuid
  mountainId String      @map("mountain_id") @db.Uuid
  type       ContentType
  title      String      @db.VarChar(200)
  body       String
  sortOrder  Int         @default(0) @map("sort_order")
  isActive   Boolean     @default(true) @map("is_active")

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@index([mountainId, type, sortOrder])
  @@map("mountain_contents")
}
