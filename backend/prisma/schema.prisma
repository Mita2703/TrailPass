generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  climber
  organizer
  admin
  officer
}

enum OrganizerStatus {
  pending
  approved
  blocked
}

enum IdType {
  ktp
  sim
  kia
  passport
}

enum Gender {
  male
  female
}

enum VerifiedStatus {
  pending
  verified
  rejected
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique @db.VarChar(255)
  passwordHash     String?          @map("password_hash") @db.VarChar(255)
  googleId         String?          @unique @map("google_id") @db.VarChar(100)
  role             Role
  fullName         String           @map("full_name") @db.VarChar(150)
  phone            String?          @db.VarChar(20)
  emailVerifiedAt  DateTime?        @map("email_verified_at")
  organizationName String?          @map("organization_name") @db.VarChar(150)
  organizerStatus  OrganizerStatus? @map("organizer_status")
  createdById      String?          @map("created_by") @db.Uuid
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  createdBy        User?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers     User[]           @relation("UserCreatedBy")
  profile          ClimberProfile?  @relation("ProfileOwner")
  verifiedProfiles ClimberProfile[] @relation("ProfileVerifier")

  organizerOf        MountainOrganizer[] @relation("OrganizerUser")
  organizerAssigned  MountainOrganizer[] @relation("OrganizerAssigner")
  officerAssignments OfficerAssignment[]
  advisoriesSet      TrailAdvisory[]

  bookings          Booking[]        @relation("BookingLeader")
  memberCheckins    BookingMember[]  @relation("MemberCheckin")
  memberCheckouts   BookingMember[]  @relation("MemberCheckout")
  scans             GateScan[]
  refundsProcessed  RefundRequest[]
  blacklistsCreated Blacklist[]
  auditLogs         AuditLog[]
  savedCompanions   SavedCompanion[]

  @@map("users")
}

model ClimberProfile {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @unique @map("user_id") @db.Uuid
  nik                   String         @db.VarChar(16)
  idType                IdType         @map("id_type")
  birthDate             DateTime       @map("birth_date") @db.Date
  gender                Gender
  emergencyContactName  String         @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String         @map("emergency_contact_phone") @db.VarChar(20)
  idPhotoUrl            String         @map("id_photo_url") @db.VarChar(500)
  privacyConsentAt      DateTime       @map("privacy_consent_at")
  verifiedStatus        VerifiedStatus @default(pending) @map("verified_status")
  rejectionReason       String?        @map("rejection_reason")
  verifiedById          String?        @map("verified_by") @db.Uuid
  verifiedAt            DateTime?      @map("verified_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user       User  @relation("ProfileOwner", fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("ProfileVerifier", fields: [verifiedById], references: [id])

  @@index([nik])
  @@map("climber_profiles")
}

enum Difficulty {
  easy
  medium
  hard
}

model Mountain {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(150)
  slug           String   @unique @db.VarChar(160)
  province       String   @db.VarChar(100)
  regency        String   @db.VarChar(100)
  elevationM     Int      @map("elevation_m")
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  timezone       String   @default("Asia/Jakarta") @db.VarChar(40)
  description    String?
  coverImage     String?  @map("cover_image") @db.VarChar(500)
  managingAgency String?  @map("managing_agency") @db.VarChar(200)
  officialUrl    String?  @map("official_url") @db.VarChar(500)
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rules  MountainRule?
  trails Trail[]

  organizers  MountainOrganizer[]
  officers    OfficerAssignment[]
  attractions Attraction[]
  documents   Document[]
  contents    MountainContent[]

  @@map("mountains")
}

model MountainRule {
  id                     String  @id @default(uuid()) @db.Uuid
  mountainId             String  @unique @map("mountain_id") @db.Uuid
  minGroup               Int     @default(1) @map("min_group")
  maxGroup               Int     @map("max_group")
  minAge                 Int?    @map("min_age")
  bookingCutoffDays      Int     @default(0) @map("booking_cutoff_days")
  holdMinutes            Int     @map("hold_minutes")
  maxDurationDays        Int     @map("max_duration_days")
  rescheduleDeadlineDays Int?    @map("reschedule_deadline_days")
  requireBriefing        Boolean @default(false) @map("require_briefing")
  extraRules             Json?   @map("extra_rules")

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Restrict)

  @@map("mountain_rules")
}

model Trail {
  id             String      @id @default(uuid()) @db.Uuid
  mountainId     String      @map("mountain_id") @db.Uuid
  name           String      @db.VarChar(150)
  distanceKm     Decimal?    @map("distance_km") @db.Decimal(5, 2)
  estimatedHours Decimal?    @map("estimated_hours") @db.Decimal(4, 1)
  difficulty     Difficulty?
  price          Int
  priceForeign   Int?        @map("price_foreign")
  extraFees      Json?       @map("extra_fees")
  queueEnabled   Boolean     @default(true) @map("queue_enabled")
  queueMaxActive Int         @default(30) @map("queue_max_active")
  ruleOverrides  Json?       @map("rule_overrides")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  mountain    Mountain     @relation(fields: [mountainId], references: [id], onDelete: Restrict)
  checkpoints Checkpoint[]

  advisories TrailAdvisory[]

  quotas   TrailQuota[]
  bookings Booking[]
  scans    GateScan[]

  @@index([mountainId])
  @@map("trails")
}

model Checkpoint {
  id       String   @id @default(uuid()) @db.Uuid
  trailId  String   @map("trail_id") @db.Uuid
  name     String   @db.VarChar(150)
  orderNo  Int      @map("order_no")
  lat      Decimal? @db.Decimal(9, 6)
  lng      Decimal? @db.Decimal(9, 6)
  isSummit Boolean  @default(false) @map("is_summit")

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)

  advisories TrailAdvisory[]

  @@unique([trailId, orderNo])
  @@map("checkpoints")
}

enum AdvisoryStatus {
  open
  limited
  closed
}

enum Severity {
  info
  warning
  danger
}

enum ContentType {
  tutorial
  faq
  checklist
  news
}

model MountainOrganizer {
  mountainId   String   @map("mountain_id") @db.Uuid
  organizerId  String   @map("organizer_id") @db.Uuid
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  mountain   Mountain @relation(fields: [mountainId], references: [id], onDelete: Restrict)
  organizer  User     @relation("OrganizerUser", fields: [organizerId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("OrganizerAssigner", fields: [assignedById], references: [id])

  @@id([mountainId, organizerId])
  @@map("mountain_organizers")
}

model OfficerAssignment {
  officerId  String @map("officer_id") @db.Uuid
  mountainId String @map("mountain_id") @db.Uuid

  officer  User     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Restrict)

  @@id([officerId, mountainId])
  @@map("officer_assignments")
}

model TrailAdvisory {
  id              String         @id @default(uuid()) @db.Uuid
  trailId         String         @map("trail_id") @db.Uuid
  status          AdvisoryStatus
  maxCheckpointId String?        @map("max_checkpoint_id") @db.Uuid
  reason          String?        @db.VarChar(200)
  message         String?
  severity        Severity       @default(info)
  validFrom       DateTime       @map("valid_from")
  validUntil      DateTime?      @map("valid_until")
  sourceUrl       String?        @map("source_url") @db.VarChar(500)
  setById         String         @map("set_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  trail         Trail       @relation(fields: [trailId], references: [id], onDelete: Restrict)
  maxCheckpoint Checkpoint? @relation(fields: [maxCheckpointId], references: [id])
  setBy         User        @relation(fields: [setById], references: [id])

  @@index([trailId, validFrom])
  @@map("trail_advisories")
}

model Attraction {
  id          String   @id @default(uuid()) @db.Uuid
  mountainId  String   @map("mountain_id") @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  image       String?  @db.VarChar(500)
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@map("attractions")
}

model Document {
  id         String @id @default(uuid()) @db.Uuid
  mountainId String @map("mountain_id") @db.Uuid
  title      String @db.VarChar(200)
  category   String @db.VarChar(100)
  fileUrl    String @map("file_url") @db.VarChar(500)

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model MountainContent {
  id         String      @id @default(uuid()) @db.Uuid
  mountainId String      @map("mountain_id") @db.Uuid
  type       ContentType
  title      String      @db.VarChar(200)
  body       String
  sortOrder  Int         @default(0) @map("sort_order")
  isActive   Boolean     @default(true) @map("is_active")

  mountain Mountain @relation(fields: [mountainId], references: [id], onDelete: Cascade)

  @@index([mountainId, type, sortOrder])
  @@map("mountain_contents")
}

enum BookingStatus {
  pending
  paid
  completed
  expired
  failed
  rescheduled
  cancelled_by_closure
  refund_requested
  refunded
}

enum MemberStatus {
  not_entered
  climbing
  exited
  manual_exit
  cancelled
  no_show
}

enum PaymentStatus {
  pending
  settlement
  expire
  cancel
  deny
}

enum RefundStatus {
  requested
  refunded
  rejected
}

enum ScanType {
  IN  @map("in")
  OUT @map("out")
}

enum ScanMethod {
  qr
  manual
}

model TrailQuota {
  id             String    @id @default(uuid()) @db.Uuid
  trailId        String    @map("trail_id") @db.Uuid
  date           DateTime  @db.Date
  totalQuota     Int       @map("total_quota")
  sold           Int       @default(0)
  isClosed       Boolean   @default(false) @map("is_closed")
  priceOverride  Int?      @map("price_override")
  bookingOpensAt DateTime? @map("booking_opens_at")

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Restrict)

  @@unique([trailId, date])
  @@map("trail_quotas")
}

model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  bookingCode         String        @unique @map("booking_code") @db.VarChar(12)
  qrToken             String?       @unique @map("qr_token") @db.VarChar(255)
  leaderUserId        String        @map("leader_user_id") @db.Uuid
  trailId             String        @map("trail_id") @db.Uuid
  climbDate           DateTime      @map("climb_date") @db.Date
  memberCount         Int           @map("member_count")
  totalAmount         Int           @map("total_amount")
  status              BookingStatus @default(pending)
  expiresAt           DateTime      @map("expires_at")
  rescheduledCount    Int           @default(0) @map("rescheduled_count")
  rescheduledFromDate DateTime?     @map("rescheduled_from_date") @db.Date
  idempotencyKey      String?       @map("idempotency_key") @db.VarChar(80)
  agreedRulesAt       DateTime?     @map("agreed_rules_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  leader   User            @relation("BookingLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  trail    Trail           @relation(fields: [trailId], references: [id], onDelete: Restrict)
  members  BookingMember[]
  payments Payment[]
  refunds  RefundRequest[]
  scans    GateScan[]

  @@unique([leaderUserId, idempotencyKey])
  @@index([trailId, climbDate, status])
  @@map("bookings")
}

model BookingMember {
  id               String       @id @default(uuid()) @db.Uuid
  bookingId        String       @map("booking_id") @db.Uuid
  fullName         String       @map("full_name") @db.VarChar(150)
  nik              String       @db.VarChar(16)
  birthDate        DateTime     @map("birth_date") @db.Date
  gender           Gender
  emergencyContact String       @map("emergency_contact") @db.VarChar(200)
  isForeign        Boolean      @default(false) @map("is_foreign")
  priceApplied     Int          @map("price_applied")
  parentLetterUrl  String?      @map("parent_letter_url") @db.VarChar(500)
  healthLetterUrl  String?      @map("health_letter_url") @db.VarChar(500)
  status           MemberStatus @default(not_entered)
  checkinAt        DateTime?    @map("checkin_at")
  checkinById      String?      @map("checkin_by") @db.Uuid
  checkoutAt       DateTime?    @map("checkout_at")
  checkoutById     String?      @map("checkout_by") @db.Uuid
  checkoutNote     String?      @map("checkout_note")

  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkinBy   User?            @relation("MemberCheckin", fields: [checkinById], references: [id])
  checkoutBy  User?            @relation("MemberCheckout", fields: [checkoutById], references: [id])
  scanMembers GateScanMember[]

  @@index([bookingId])
  @@index([nik])
  @@index([status])
  @@map("booking_members")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  midtransOrderId String        @unique @map("midtrans_order_id") @db.VarChar(100)
  snapToken       String?       @map("snap_token") @db.VarChar(255)
  method          String?       @db.VarChar(50)
  grossAmount     Int           @map("gross_amount")
  status          PaymentStatus @default(pending)
  rawNotification Json?         @map("raw_notification")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("payments")
}

model RefundRequest {
  id            String       @id @default(uuid()) @db.Uuid
  bookingId     String       @map("booking_id") @db.Uuid
  reason        String
  amount        Int
  status        RefundStatus @default(requested)
  processedById String?      @map("processed_by") @db.Uuid
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  processedBy User?   @relation(fields: [processedById], references: [id])

  @@map("refund_requests")
}

model GateScan {
  id          String     @id @default(uuid()) @db.Uuid
  bookingId   String     @map("booking_id") @db.Uuid
  trailId     String     @map("trail_id") @db.Uuid
  scanType    ScanType   @map("scan_type")
  scanMethod  ScanMethod @map("scan_method")
  scannedById String     @map("scanned_by") @db.Uuid
  scannedAt   DateTime   @default(now()) @map("scanned_at")
  note        String?

  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  trail     Trail            @relation(fields: [trailId], references: [id])
  scannedBy User             @relation(fields: [scannedById], references: [id])
  members   GateScanMember[]

  @@index([bookingId, scannedAt])
  @@map("gate_scans")
}

model GateScanMember {
  scanId   String @map("scan_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  scan   GateScan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  member BookingMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([scanId, memberId])
  @@map("gate_scan_members")
}

model Blacklist {
  id          String    @id @default(uuid()) @db.Uuid
  nik         String    @db.VarChar(16)
  fullName    String    @map("full_name") @db.VarChar(150)
  reason      String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([nik])
  @@map("blacklists")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  detail     Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SavedCompanion {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  fullName         String   @map("full_name") @db.VarChar(150)
  nik              String   @db.VarChar(16)
  birthDate        DateTime @map("birth_date") @db.Date
  gender           Gender
  emergencyContact String   @map("emergency_contact") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_companions")
}
