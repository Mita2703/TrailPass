# ==========================================
# TrailPass Backend Configuration
# ==========================================

NODE_ENV=production
PORT=4000
DATABASE_URL="postgresql://trailpass:trailpass@localhost:5432/trailpass"
REDIS_URL="redis://localhost:6379"

# Keamanan Token & QR E-Tiket
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
QR_SIGNING_SECRET="ganti-dengan-string-acak-rahasia-minimal-32-karakter"

# URL Frontend untuk CORS
FRONTEND_URL="http://localhost:5173"

# Seed default password
SEED_DEFAULT_PASSWORD="trailpassPassword2026"

# Midtrans Payment Gateway (Sandbox / Production)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION=false
